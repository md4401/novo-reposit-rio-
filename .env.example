# Connection string do Neon (console.neon.tech → seu projeto → Connect). Use a versão "pooled".
DATABASE_URL=postgresql://usuario:senha@ep-exemplo-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require

# IA opcional para a Nia (respostas livres e leitura de nota fiscal). Sem chave, a Nia usa regras locais.
# OpenAI:  AI_API_KEY=sk-...            (AI_MODEL padrão: gpt-5-mini)
# Gemini (tem plano gratuito, chave em aistudio.google.com):
#   AI_API_KEY=...  AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai  AI_MODEL=gemini-2.5-flash
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=

# Só para gerar o APK Android: endereço público do app (a Vercel mostra depois do deploy)
VITE_API_URL=
