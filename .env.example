# Connection string do Neon (console.neon.tech → seu projeto → Connect). Use a versão "pooled".
DATABASE_URL=postgresql://usuario:senha@ep-exemplo-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require

# IA opcional para a Nia (respostas, classificação, leitura de nota fiscal e mensagens de voz).
# Sem chave, a Nia usa regras locais. O provedor é reconhecido pela chave:
#   Groq (gsk_..., plano grátis em console.groq.com) → modelo qwen/qwen3.8-27b + voz whisper-large-v3-turbo
#   Gemini (AIza..., aistudio.google.com)            → gemini-2.5-flash (sem mensagens de voz)
#   OpenAI (sk-...)                                  → gpt-5-mini + whisper-1
AI_API_KEY=
# Opcionais (só para trocar o padrão):
# AI_BASE_URL=   AI_MODEL=   AI_VISION_MODEL=   AI_TRANSCRIBE_MODEL=

# Só para gerar o APK Android: endereço público do app (a Vercel mostra depois do deploy)
VITE_API_URL=
